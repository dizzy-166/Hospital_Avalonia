<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Hospital.Views.LoginPageView"
             xmlns:vm="using:Hospital.ViewModels"
             x:DataType="vm:LoginPageViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
	  <TextBlock Text="Insert Login"/>
      <TextBox Text="{Binding Login}"/>
      <TextBlock Text="Insert Password"/>
      <TextBox Text="{Binding Password}" PasswordChar="*"/>
      <Button Content="Sign up" Command="{Binding Enter}"/>
      <TextBlock Text="{Binding Message}" Foreground="Red"/>
  </StackPanel>
</UserControl>
