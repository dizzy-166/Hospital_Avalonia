<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Hospital.Views.LoginPageView"
             xmlns:vm="using:Hospital.ViewModels"
             x:DataType="vm:LoginPageViewModel">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Spacing="15">
        <!-- Заголовок -->
        <TextBlock Text="Hospital System" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="#2C3E50"
                   Margin="0,0,0,10"/>
        
        <!-- Поле логина -->
        <StackPanel Spacing="5">
            <TextBlock Text="Login" 
                       FontWeight="SemiBold"
                       Foreground="#495057"/>
            <TextBox Text="{Binding Login}" 
                     Padding="12,8"
                     FontSize="14"
                     BorderBrush="#CED4DA"
                     BorderThickness="1"
                     CornerRadius="4"/>
        </StackPanel>
        
        <!-- Поле пароля -->
        <StackPanel Spacing="5">
            <TextBlock Text="Password" 
                       FontWeight="SemiBold"
                       Foreground="#495057"/>
            <TextBox Text="{Binding Password}" 
                     PasswordChar="*"
                     Padding="12,8"
                     FontSize="14"
                     BorderBrush="#CED4DA"
                     BorderThickness="1"
                     CornerRadius="4"/>
        </StackPanel>
        
        <!-- Кнопка входа -->
        <Button Content="Sign In" 
                Command="{Binding Enter}"
                Padding="20,12"
                Background="#007BFF"
                Foreground="White"
                BorderBrush="#007BFF"
                BorderThickness="0"
                CornerRadius="4"
                FontWeight="SemiBold"
                FontSize="14"
                Margin="0,10,0,0"/>
        
        <!-- Сообщение об ошибке -->
        <TextBlock Text="{Binding Message}" 
                   Foreground="#DC3545"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="280"/>
    </StackPanel>
</UserControl>